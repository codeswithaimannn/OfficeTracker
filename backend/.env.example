# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:your-password-here@localhost:5432/orbitask_dev?schema=public"

# Port the API listens on
PORT=3000

# Secret used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-with-a-long-random-string"
